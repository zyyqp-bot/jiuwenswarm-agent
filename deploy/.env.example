# Copy these values into CloudBase 云托管 → 服务设置 → 环境变量.
# Never commit a filled copy. Every value below is a placeholder.

# production refuses to start with a secret shorter than 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# user:password;user:password — one entry per judge account.
WORKBENCH_USERS=judge1:replace-me;judge2:replace-me

# Model endpoint. The key stays server-side; it is never sent to the browser.
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=replace-with-provider-key
MODEL_NAME=deepseek-chat

# The persistent volume mount. Must match the volume configured in CloudBase.
WORKBENCH_DATA_DIR=/data
WORKBENCH_ENV=production

# Admission limits. One worker; each run is a Python child process.
# On a 2 GB instance set the global cap to 1.
WORKBENCH_MAX_CONCURRENT_RUNS=2
WORKBENCH_MAX_CONCURRENT_PER_SESSION=1
WORKBENCH_MAX_RUNS_PER_DAY=30
WORKBENCH_ROUND_DEADLINE_SECONDS=300
