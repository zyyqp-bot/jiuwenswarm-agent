# Local Python environment
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Upstream reference checkouts.
# These are the official JiuwenSwarm / agent-core source trees, pinned by
# source-lock.json. Do not commit them; reproduce with the commands recorded
# in PROJECT.md section 13.
upstream/

# Project runtime data (design target; not yet implemented)
project-data/

# Framework log output from local probes/experiments
logs/

# Live-round runtime artifacts: child snapshots, atexit marker, captured stdout
p1/.live_round/

# Local model credentials for the live run. Never commit: this holds an API
# key, and the live checks read it from the environment rather than from a
# tracked file.
.env.local

# Web dependencies and build output (the container rebuilds both)
web/node_modules/
web/dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
